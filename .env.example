# Copy to .env and fill in. Never commit .env.

# Supabase Postgres (Connect -> ORMs -> Prisma)
# App runtime: transaction pooler, port 6543
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations: session pooler, port 5432
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase (Project Settings -> API Keys)
SUPABASE_URL="https://<ref>.supabase.co"
# Public key, injected into the browser bundle
SUPABASE_ANON_KEY="sb_publishable_..."
# Server only
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# The Odds API (server only)
ODDS_API_KEY=""

# Shared passcode friends enter before signing up
SIGNUP_PASSCODE=""

# Optional, defaults to 8080
# PORT=8080

# Stripe (server only). Test-mode keys locally, live keys in production
STRIPE_SECRET_KEY="sk_test_..."
# The $5/mo recurring price (Product catalog -> price id)
STRIPE_PRICE_ID="price_..."
# Signing secret of the webhook endpoint (or from `stripe listen` locally)
STRIPE_WEBHOOK_SECRET="whsec_..."
# Where Checkout and the billing portal send people back to
APP_URL="http://localhost:4000"
