generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Users ----------

enum SubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

/// App profile for a Supabase Auth user. `id` is the Supabase auth.users id.
model User {
  id          String   @id @db.Uuid
  username    String   @unique
  fullName    String
  avatarUrl   String?
  /// Monogram background when there's no photo: a SERIES_COLORS key (shared/series.ts)
  avatarColor String   @default("emerald")
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Stripe ($5/mo), synced by the webhook in routes/billing.ts. Access rules: shared/billing.ts
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  subscriptionStatus   SubscriptionStatus @default(NONE)
  currentPeriodEnd     DateTime?
  /// Canceled in the billing portal; access runs to currentPeriodEnd
  cancelAtPeriodEnd    Boolean            @default(false)

  /// Admins bypass the subscription paywall
  isAdmin Boolean @default(false)

  /// When they finished or skipped the first-visit tour (null = show it)
  tutorialSeenAt DateTime?

  /// Notification switches they've changed from the defaults (shared/notifications.ts)
  notifyPrefs Json @default("{}")

  pushSubscriptions PushSubscription[]
  posts             Post[]
  tails             Tail[]
  fades             Fade[]
  comments          Comment[]
  reactions         Reaction[]
  commentVotes      CommentVote[]
  groupLegs         BetLeg[]
  series            Series[]
}

// ---------- Reference data (mirrors The Odds API) ----------

model Sportsbook {
  id               String  @id @default(cuid())
  /// The Odds API bookmaker key, e.g. "draftkings", "williamhill_us" (Caesars)
  key              String  @unique
  name             String
  logoUrl          String?
  /// Whether Tail can deep-link into this book's betslip
  supportsDeepLink Boolean @default(false)
  active           Boolean @default(true)

  posts Post[]
}

model Sport {
  /// The Odds API sport key, e.g. "americanfootball_nfl"
  key    String  @id
  title  String
  active Boolean @default(true)

  events  Event[]
  players Player[]
}

model Event {
  /// The Odds API event id
  id           String   @id
  sportKey     String
  homeTeam     String
  awayTeam     String
  commenceTime DateTime
  completed    Boolean  @default(false)
  homeScore    Int?
  awayScore    Int?
  /// Game clock while it's on, e.g. "Q3 4:12", "Half", "P2 08:41"; "Final" after
  statusDetail String?
  /// ESPN game id, once matched for grading
  espnId       String?
  updatedAt    DateTime @updatedAt

  sport Sport    @relation(fields: [sportKey], references: [key])
  legs  BetLeg[]

  @@index([sportKey, commenceTime])
}

model Player {
  id          String   @id @default(cuid())
  /// Name as The Odds API returns it in outcome descriptions
  name        String
  sportKey    String
  team        String?
  headshotUrl String?
  updatedAt   DateTime @updatedAt

  sport Sport    @relation(fields: [sportKey], references: [key])
  legs  BetLeg[]

  @@unique([name, sportKey])
}

// ---------- Posts & bets ----------

enum PostType {
  STRAIGHT // one bet, one leg
  PARLAY // one bet, many legs
  LADDER // many single-leg bets: same pick at climbing lines
  GROUP_PARLAY // one bet; each friend adds one leg (BetLeg.addedById) until it locks
}

enum BetResult {
  PENDING
  WON
  LOST
  PUSH
  VOID
}

/// Who set a result: the auto-grader, or a person (the grader never overwrites MANUAL)
enum GradeSource {
  AUTO
  MANUAL
}

model Post {
  id              String    @id @default(cuid())
  authorId        String    @db.Uuid
  type            PostType
  caption         String?
  sportsbookId    String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  /// Group parlays: no more legs after this deadline
  lockAt          DateTime?
  /// Group parlays: set when the creator keeps it to one game (Odds API event id + label)
  groupEventId    String?
  groupEventLabel String?
  /// Group parlays: when the creator locked it early
  lockedAt        DateTime?
  /// Group parlays: when the "locks soon" notification went out (sent once)
  lockReminderAt  DateTime?
  /// The author's series this slip is filed under, if any (personal slips only)
  seriesId        String?

  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  sportsbook Sportsbook @relation(fields: [sportsbookId], references: [id])
  series     Series?    @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  bets       Bet[]
  comments   Comment[]
  reactions  Reaction[]
  fades      Fade[]

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([seriesId, createdAt])
}

/// A named run of slips a user posts under, e.g. "CharLadder". Followable later.
model Series {
  id          String   @id @default(cuid())
  ownerId     String   @db.Uuid
  name        String
  description String?
  /// Cover: one of SERIES_EMOJIS on a SERIES_COLORS background (shared/series.ts)
  emoji       String   @default("📚")
  color       String   @default("emerald")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  posts Post[]

  @@unique([ownerId, name])
}

/// A single slip. Straight/parlay posts have one; ladder posts have one per rung.
model Bet {
  id           String       @id @default(cuid())
  postId       String
  /// Ladder rung position (0 for straight/parlay)
  order        Int          @default(0)
  units        Decimal      @db.Decimal(6, 2)
  /// Total odds as shown on the book's slip (may differ from multiplied legs for same-game parlays)
  americanOdds Int
  /// Used for "$10 pays $X" = 10 * decimalOdds
  decimalOdds  Decimal      @db.Decimal(12, 4)
  result       BetResult    @default(PENDING)
  settledAt    DateTime?
  gradedBy     GradeSource?
  /// Betslip deep link covering the whole bet, when the book supports multi-leg links
  deepLink     String?

  post  Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  legs  BetLeg[]
  tails Tail[]

  @@unique([postId, order])
}

model BetLeg {
  id              String       @id @default(cuid())
  betId           String
  order           Int          @default(0)
  sportKey        String
  eventId         String?
  /// Display matchup, e.g. "Chiefs @ Bills" (always set, so manual legs need no Event row)
  eventLabel      String
  /// The Odds API market key, e.g. "h2h", "spreads", "player_pass_tds"; "player_prop" for manual props
  marketKey       String
  /// Display name for props, e.g. "Passing TDs"
  marketLabel     String?
  /// Outcome name, e.g. "Kansas City Chiefs", "Over"
  selection       String
  playerId        String?
  playerName      String?
  /// Point/line, e.g. -3.5 or 1.5
  line            Decimal?     @db.Decimal(8, 2)
  americanOdds    Int
  result          BetResult    @default(PENDING)
  gradedBy        GradeSource?
  /// The player stat a prop was graded on (e.g. 212 passing yards)
  actual          Decimal?     @db.Decimal(8, 2)
  /// Book's selection id + single-leg deep link from The Odds API (includeSids / includeLinks)
  bookSelectionId String?
  deepLink        String?
  /// Group parlays: whose leg this is (one per person per parlay)
  addedById       String?      @db.Uuid

  bet     Bet     @relation(fields: [betId], references: [id], onDelete: Cascade)
  event   Event?  @relation(fields: [eventId], references: [id])
  player  Player? @relation(fields: [playerId], references: [id])
  addedBy User?   @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([betId, order])
  @@unique([betId, addedById])
  @@index([eventId])
}

// ---------- Social ----------

/// A user tailing a bet. Never shown on the tailer's profile; used for tail counts
/// and each user's record on bets they tailed from a given poster.
model Tail {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  betId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bet  Bet  @relation(fields: [betId], references: [id], onDelete: Cascade)

  @@unique([userId, betId])
  @@index([betId])
}

/// Betting against a slip. One per person per slip, and never alongside a tail
model Fade {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  authorId  String    @db.Uuid
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  post   Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes  CommentVote[]

  @@index([postId, createdAt])
}

/// Like (+1) or dislike (-1) on a comment; one per user
model CommentVote {
  commentId String
  userId    String   @db.Uuid
  value     Int
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
}

model Reaction {
  postId    String
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId, emoji])
}

/// A browser or home-screen app that turned notifications on (Web Push). The
/// endpoint is the push service's address for it; p256dh + auth encrypt payloads.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Billing ----------

/// Processed Stripe webhook events, so retries aren't applied twice
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}
